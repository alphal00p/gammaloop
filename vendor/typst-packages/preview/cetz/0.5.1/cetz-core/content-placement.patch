@@ -0,0 +1,189 @@
+use crate::{deserialize_point, deserialize_points, handle_cbor, Point};
+use serde::{Deserialize, Serialize};
+
+#[derive(Deserialize)]
+#[serde(rename_all = "kebab-case")]
+struct ContentGroup {
+    #[serde(deserialize_with = "deserialize_point")]
+    north_east: Point,
+    #[serde(deserialize_with = "deserialize_point")]
+    south_east: Point,
+    #[serde(deserialize_with = "deserialize_points")]
+    positions: Vec<Point>,
+}
+
+#[derive(Deserialize)]
+struct ContentRects {
+    #[serde(deserialize_with = "deserialize_points")]
+    transform: Vec<Point>,
+    groups: Vec<ContentGroup>,
+}
+
+#[derive(Serialize)]
+struct ContentRect([f64; 3], f64, f64, Vec<Subpath>);
+
+type Subpath = ([f64; 3], bool, Vec<(&'static str, [f64; 3])>);
+
+#[derive(Serialize)]
+struct PlacedContent {
+    // A nonfinite geometry uses CeTZ's scalar placement and comparison rules.
+    finite: bool,
+    groups: Vec<Vec<ContentRect>>,
+}
+
+impl ContentRects {
+    fn place(self) -> Result<PlacedContent, String> {
+        if self.transform.len() != 4
+            || self.transform.iter().any(|row| row.len() != 4)
+            || self.groups.iter().any(|g| {
+                g.north_east.len() != 3
+                    || g.south_east.len() != 3
+                    || g.positions
+                        .iter()
+                        .any(|point| !(2..=3).contains(&point.len()))
+            })
+        {
+            return Err(
+                "Content placement requires a 4x4 transform, 3D offsets and 2D/3D points".into(),
+            );
+        }
+        let identity = self.transform.iter().enumerate().all(|(row, values)| {
+            values
+                .iter()
+                .enumerate()
+                .all(|(column, &value)| value == if row == column { 1.0 } else { 0.0 })
+        });
+        let mut finite = true;
+        let groups = self
+            .groups
+            .iter()
+            .map(|group| {
+                group
+                    .positions
+                    .iter()
+                    .map(|point| {
+                        let mut position =
+                            [point[0], point[1], point.get(2).copied().unwrap_or(0.0)];
+                        if !identity {
+                            position = [0, 1, 2].map(|i| {
+                                let row = &self.transform[i];
+                                row[0] * point[0]
+                                    + row[1] * point[1]
+                                    + row[2] * point.get(2).copied().unwrap_or(0.0)
+                                    + row[3] * 1.0
+                            });
+                        }
+                        // Keep addition/subtraction separate, as in CeTZ content anchors.
+                        let ne = [0, 1, 2].map(|i| position[i] + group.north_east[i]);
+                        let nw = [0, 1, 2].map(|i| position[i] - group.south_east[i]);
+                        let se = [0, 1, 2].map(|i| position[i] + group.south_east[i]);
+                        let sw = [0, 1, 2].map(|i| position[i] - group.north_east[i]);
+                        finite &= [position, nw, ne, sw, se]
+                            .iter()
+                            .flatten()
+                            .all(|v| v.is_finite());
+                        let extent = |axis: usize| {
+                            let values = [nw[axis], ne[axis], sw[axis], se[axis]];
+                            let low = values.iter().copied().reduce(f64::min).unwrap();
+                            let high = values.iter().copied().reduce(f64::max).unwrap();
+                            (high - low).abs()
+                        };
+                        let mut current = nw;
+                        let mut segments = Vec::new();
+                        for point in [ne, se, sw, nw] {
+                            if point != current {
+                                segments.push(("l", point));
+                            }
+                            current = point;
+                        }
+                        let (width, height) = (extent(0), extent(1));
+                        finite &= width.is_finite() && height.is_finite();
+                        ContentRect(position, width, height, vec![(nw, true, segments)])
+                    })
+                    .collect()
+            })
+            .collect();
+        Ok(PlacedContent { finite, groups })
+    }
+}
+
+/// Place prepared rectangular content without changing coordinate arithmetic.
+pub(super) fn content_rects(input: &[u8]) -> Result<Vec<u8>, String> {
+    handle_cbor(input, ContentRects::place)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn input(positions: Vec<Point>) -> ContentRects {
+        ContentRects {
+            transform: (0..4)
+                .map(|row| (0..4).map(|column| f64::from(row == column)).collect())
+                .collect(),
+            groups: vec![ContentGroup {
+                north_east: vec![0.5, 0.25, 0.0],
+                south_east: vec![0.5, -0.25, 0.0],
+                positions,
+            }],
+        }
+    }
+
+    #[test]
+    fn rectangular_frame_keeps_corner_and_closing_order() {
+        let placed = input(vec![vec![2.0, -3.0]]).place().unwrap();
+        assert!(placed.finite);
+        let ContentRect(position, width, height, subpaths) = &placed.groups[0][0];
+        assert_eq!(*position, [2.0, -3.0, 0.0]);
+        assert_eq!((*width, *height), (1.0, 0.5));
+        assert_eq!(
+            subpaths,
+            &vec![(
+                [1.5, -2.75, 0.0],
+                true,
+                vec![
+                    ("l", [2.5, -2.75, 0.0]),
+                    ("l", [2.5, -3.25, 0.0]),
+                    ("l", [1.5, -3.25, 0.0]),
+                    ("l", [1.5, -2.75, 0.0]),
+                ]
+            )]
+        );
+    }
+
+    #[test]
+    fn matrix_multiplication_keeps_scalar_addition_order() {
+        let mut request = input(vec![vec![1.0, 1.0, 1.0]]);
+        request.transform[0] = vec![1e16, -1e16, 1.0, 2.0];
+        let placed = request.place().unwrap();
+        assert_eq!(placed.groups[0][0].0[0], 3.0);
+    }
+
+    #[test]
+    fn zero_sized_content_keeps_an_empty_closed_subpath() {
+        let mut request = input(vec![vec![-0.0, 0.0]]);
+        request.groups[0].north_east = vec![0.0; 3];
+        request.groups[0].south_east = vec![0.0; 3];
+        let placed = request.place().unwrap();
+        assert_eq!(placed.groups[0][0].3[0].0[0].to_bits(), (-0.0f64).to_bits());
+        assert!(placed.groups[0][0].3[0].1);
+        assert!(placed.groups[0][0].3[0].2.is_empty());
+    }
+
+    #[test]
+    fn nonfinite_and_overflow_geometry_requires_scalar_placement() {
+        for value in [f64::INFINITY, f64::NEG_INFINITY, f64::NAN, 1e308] {
+            let mut request = input(vec![vec![value, 0.0]]);
+            request.transform[0][0] = 2.0;
+            assert!(!request.place().unwrap().finite);
+        }
+    }
+
+    #[test]
+    fn invalid_dimensions_are_rejected() {
+        assert!(input(vec![vec![1.0]]).place().is_err());
+        let mut request = input(vec![]);
+        request.transform.pop();
+        assert!(request.place().is_err());
+    }
+}
