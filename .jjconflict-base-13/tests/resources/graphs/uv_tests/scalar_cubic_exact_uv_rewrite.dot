digraph scalar_cubic_exact_uv_rewrite {
    node [num = "1"]
    edge [particle = scalar_1 num = "1" dod = -100]

    incoming [style = invis]
    outgoing [style = invis]

    incoming -> v5 [id = 0]
    v0 -> v2 [id = 1 lmb_id = 0]
    v3 -> v0 [id = 2]
    v0 -> v5 [id = 3]

    // This is the only UV-active cycle. Its leading UV routings are Q, Q, -Q;
    // the two edge-local factors keep its degree-two numerator unexpanded.
    v2 -> v1 [
        id = 4
        dod = -1
        num = "Q(4,spenso::cind(0))+UFO::mass_scalar_1"
    ]
    v1 -> v3 [
        id = 5
        lmb_id = 1
        dod = -1
        num = "Q(5,spenso::cind(0))-2*UFO::mass_scalar_1"
    ]
    v1 -> v4 [id = 6]
    v2 -> v3 [id = 7 dod = -2]
    v4 -> outgoing [id = 8]
}
