+impl FootprintInput {
+    fn resolve(mut self) -> Result<FootprintBatch, String> {
+        self.batch.paths = match self.paths {
+            FootprintPaths::Resolved(paths) => paths,
+            FootprintPaths::Packets(packets) => {
+                let styles = self
+                    .shaft_styles
+                    .ok_or("missing shaft styles for path packets")?;
+                packets
+                    .into_iter()
+                    .flat_map(|packet| packet.0)
+                    .map(|path| {
+                        let style = &styles[usize::from(!path.single)];
+                        FootprintPath {
+                            segments: path.segments,
+                            shaft_radius: style.shaft_radius,
+                            shaft_visible: style.shaft_visible,
+                        }
+                    })
+                    .collect()
+            }
+        };
+        Ok(self.batch)
+    }
+}
+#[derive(Debug, PartialEq, Serialize)]
+struct Footprint {
+    left: f64,
+    right: f64,
+    bottom: f64,
+    top: f64,
+}
+impl Footprint {
+    fn points(points: Vec<Point>, radius: f64) -> Result<Self, String> {
+        if points.iter().flatten().any(|x| !x.is_finite()) {
+            return Err("marker footprint overflow".into());
+        }
+        let bounds = aabb(None, points)?;
+        let footprint = Self {
+            left: bounds.low[0] - radius,
+            right: bounds.high[0] + radius,
+            bottom: bounds.low[1] - radius,
+            top: bounds.high[1] + radius,
+        };
+        if [
+            footprint.left,
+            footprint.right,
+            footprint.bottom,
+            footprint.top,
+        ]
+        .iter()
+        .any(|x| !x.is_finite())
+        {
+            return Err("marker footprint overflow".into());
+        }
+        Ok(footprint)
+    }
+    fn path(segments: &Path, radius: f64) -> Result<Option<Self>, String> {
+        let mut points = Vec::new();
+        for (origin, _, commands) in segments {
+            points.push(origin.clone());
+            for command in commands {
+                command.append_bounds(&mut points)?;
+            }
+        }
+        if points.is_empty() {
+            Ok(None)
+        } else {
+            Self::points(points, radius).map(Some)
+        }
+    }
+}
+impl FootprintBatch {
+    fn valid_point(point: &Point) -> bool {
+        (2..=3).contains(&point.len()) && point.iter().all(|x| x.is_finite())
+    }
+    fn valid_path(path: &Path) -> bool {
+        path.iter().all(|(origin, _, commands)| {
+            Self::valid_point(origin)
+                && commands
+                    .iter()
+                    .all(|c| c.points.iter().all(Self::valid_point))
+        })
+    }
+    fn point(matrix: &Matrix, point: &Point) -> Point {
+        if *matrix == IDENTITY {
+            let mut point = point.clone();
+            point.resize(3, 0.0);
+            return point;
+        }
+        let (x, y, z) = (point[0], point[1], point.get(2).copied().unwrap_or(0.0));
+        matrix[..3]
+            .iter()
+            .map(|row| row[0] * x + row[1] * y + row[2] * z + row[3] * 1.0)
+            .collect()
+    }
+    fn transform_path(matrix: &Matrix, path: &mut Path) {
+        // drawable.apply-transform returns unchanged geometry for identity.
+        if *matrix == IDENTITY {
+            return;
+        }
+        for (origin, _, commands) in path {
+            *origin = Self::point(matrix, origin);
+            for command in commands {
+                for point in &mut command.points {
+                    *point = Self::point(matrix, point);
+                }
+            }
+        }
+    }
+    fn joined(path: Path) -> Path {
+        let mut joined: Path = Vec::new();
+        for (mut origin, closed, mut commands) in path {
+            origin.resize(3, 0.0);
+            for command in &mut commands {
+                for point in &mut command.points {
+                    point.resize(3, 0.0);
+                }
+            }
+            let end = commands.last().map(Command::end).unwrap_or(&origin);
+            if closed && *end != origin {
+                commands.push(Command {
+                    kind: "l".into(),
+                    points: vec![origin.clone()],
+                });
+            }
+            // Normalize each drawable before joining, as _cetz-carrier does
+            // under the identity transform. Keep the previous original end.
+            let mut previous = origin.clone();
+            commands.retain(|command| {
+                let keep = command.kind != "l" || *command.end() != previous;
+                previous = command.end().clone();
+                keep
+            });
+            if let Some((start, _, prior)) = joined.first_mut() {
+                let end = prior.last().map(Command::end).unwrap_or(start);
+                if *end != origin {
+                    prior.push(Command {
+                        kind: "l".into(),
+                        points: vec![origin],
+                    });
+                }
+                prior.extend(commands);
+            } else {
+                joined.push((origin, false, commands));
+            }
+        }
+        joined
+    }
+    fn bounds(self) -> Result<Vec<Vec<Footprint>>, String> {
+        let valid_radius = |r: f64| r.is_finite() && r >= 0.0;
+        if self.transform.iter().flatten().any(|x| !x.is_finite())
+            || !self.shift.is_finite()
+            || self.ratio.is_some_and(|x| !x.is_finite())
+            || self
+                .paths
+                .iter()
+                .any(|p| !valid_radius(p.shaft_radius) || !Self::valid_path(&p.segments))
+            || self.marks.iter().any(|m| {
+                m.side > 1
+                    || !Self::valid_point(&m.tip)
+                    || !Self::valid_point(&m.back)
+                    || m.tip.len() != m.back.len()
+                    || !m.length.is_finite()
+                    || m.length < 0.0
+                    || !m.sep.is_finite()
+                    || !m.offset.value.is_finite()
+                    || m.pos.as_ref().is_some_and(|p| !p.value.is_finite())
+                    || m.drawables.iter().any(|d| match d {
+                        TemplateDrawable::Path {
+                            segments, radius, ..
+                        } => !valid_radius(*radius) || !Self::valid_path(segments),
+                        TemplateDrawable::Content {
+                            pos,
+                            width,
+                            height,
+                            radius,
+                            ..
+                        } => {
+                            !valid_radius(*radius)
+                                || !Self::valid_point(pos)
+                                || !width.is_finite()
+                                || !height.is_finite()
+                        }
+                    })
+            })
+        {
+            return Err(
+                "marker footprints require finite 2D/3D geometry and nonnegative radii/lengths"
+                    .into(),
+            );
+        }
+        let mut projection = IDENTITY;
+        projection[2][2] = 0.0;
+        let flat_transform = multiply(projection, &[self.transform]);
+        let mut all = Vec::with_capacity(self.paths.len());
+        for input in self.paths {
+            let mut segments = Self::joined(input.segments);
+            if self.flat {
+                Self::transform_path(&flat_transform, &mut segments);
+            }
+            let mut total = 0.0;
+            for (origin, _, commands) in &segments {
+                let mut previous = origin;
+                let mut subtotal = 0.0;
+                for command in commands {
+                    subtotal += command.length(previous);
+                    previous = command.end();
+                }
+                total += subtotal;
+            }
+            if !total.is_finite() {
+                return Err("marker carrier length overflow".into());
+            }
+            let mut at = match self.ratio {
+                None => [0.0, 0.0],
+                Some(ratio) => [
+                    ratio * total + self.shift,
+                    (1.0 - ratio) * total - self.shift,
+                ],
+            };
+            let marks = if total > 0.0 {
+                self.marks
+                    .iter()
+                    .map(|m| m.placed(&mut at[m.side], total))
+                    .collect()
+            } else {
+                Vec::new()
+            };
+            let mut painted = Carrier {
+                segments,
+                total,
+                paint: true,
+                marks,
+            }
+            .paint()?;
+            if !self.flat {
+                Self::transform_path(&self.transform, &mut painted.segments);
+            }
+            let mut bounds = Vec::new();
+            if input.shaft_visible {
+                for (origin, _, commands) in &painted.segments {
+                    let mut previous = origin;
+                    for command in commands {
+                        let mut points = vec![previous.clone()];
+                        command.append_bounds(&mut points)?;
+                        bounds.push(Footprint::points(points, input.shaft_radius)?);
+                        previous = command.end();
+                    }
+                }
+            }
+            for (template, placement) in self.marks.iter().zip(painted.marks) {
+                for drawable in &template.drawables {
+                    match drawable {
+                        TemplateDrawable::Path {
+                            segments,
+                            radius,
+                            visible,
+                        } if *visible => {
+                            let mut segments = segments.clone();
+                            Self::transform_path(&placement.alignment, &mut segments);
+                            if !self.flat {
+                                Self::transform_path(&self.transform, &mut segments);
+                            }
+                            if let Some(bound) = Footprint::path(&segments, *radius)? {
+                                bounds.push(bound);
+                            }
+                        }
+                        TemplateDrawable::Content {
+                            pos,
+                            width,
+                            height,
+                            radius,
+                            visible,
+                        } if *visible => {
+                            let mut pos = Self::point(&placement.alignment, pos);
+                            if !self.flat {
+                                pos = Self::point(&self.transform, &pos);
+                            }
+                            // CeTZ transforms content position but retains these
+                            // dimensions; collision boxes intentionally stay AABBs.
+                            bounds.push(Footprint::points(
+                                vec![
+                                    vec![pos[0] - width / 2.0, pos[1] - height / 2.0],
+                                    vec![pos[0] + width / 2.0, pos[1] + height / 2.0],
+                                ],
+                                *radius,
+                            )?);
+                        }
+                        _ => {}
+                    }
+                }
+            }
+            all.push(bounds);
+        }
+        Ok(all)
+    }
+}
+pub(super) fn footprints(input: &[u8]) -> Result<Vec<u8>, String> {
+    handle_cbor(input, |input: FootprintInput| input.resolve()?.bounds())
+}
