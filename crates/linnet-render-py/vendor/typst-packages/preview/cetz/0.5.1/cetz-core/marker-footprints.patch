+impl<'de> Deserialize<'de> for NumericPaths {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        let Value::Bytes(bytes) = Value::deserialize(deserializer)? else {
