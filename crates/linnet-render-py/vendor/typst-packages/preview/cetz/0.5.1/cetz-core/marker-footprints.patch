+impl BoundsSegment {
+    /// Append the original path-util.bounds point stream. Both the public AABB
+    /// API and marker footprints use this owner, including its extrema rounding.
+    pub(super) fn append_bounds(&self, bounds: &mut Vec<Point>) -> Result<(), String> {
+        match self.kind.as_str() {
+            "l" => bounds.extend(self.points.iter().cloned()),
+            "c" if self.points.len() == 3 => {
+                bounds.extend(cubic_extrema(
+                    normalize_point3(bounds.last().unwrap().clone()),
+                    normalize_point3(self.points[2].clone()),
+                    normalize_point3(self.points[0].clone()),
+                    normalize_point3(self.points[1].clone()),
+                )?);
+                bounds.push(self.points[2].clone());
+            }
+            "c" => return Err("A cubic requires three points".to_owned()),
+            _ => {}
+        }
+        Ok(())
+    }
