index 0000000..3b96e0a
--- /dev/null
+++ b/cetz-core/src/bounds.rs
@@ -0,0 +1,89 @@
+use super::{aabb, cubic_extrema, deserialize_point, handle_cbor, normalize_point3, Bounds, Point};
+use serde::{Deserialize, Serialize};
+
+#[derive(Deserialize)]
+#[serde(transparent)]
+struct BoundsPoint(#[serde(deserialize_with = "deserialize_point")] Point);
+
+struct BoundsSegment {
+    kind: String,
+    points: Vec<Point>,
+}
+
+impl<'de> Deserialize<'de> for BoundsSegment {
+    fn deserialize<D: serde::Deserializer<'de>>(de: D) -> Result<Self, D::Error> {
+        struct SegmentVisitor;
+        impl<'de> serde::de::Visitor<'de> for SegmentVisitor {
+            type Value = BoundsSegment;
+            fn expecting(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {
+                f.write_str("a segment kind followed by points")
+            }
+            fn visit_seq<A: serde::de::SeqAccess<'de>>(
+                self,
+                mut seq: A,
+            ) -> Result<Self::Value, A::Error> {
+                let kind = seq
+                    .next_element()?
+                    .ok_or_else(|| serde::de::Error::custom("empty segment"))?;
+                let mut points = Vec::new();
+                while let Some(BoundsPoint(point)) = seq.next_element()? {
+                    points.push(point);
+                }
+                Ok(BoundsSegment { kind, points })
+            }
+        }
+        de.deserialize_seq(SegmentVisitor)
+    }
+}
+
+#[derive(Deserialize)]
+struct PathAabbArgs {
+    path: Vec<(BoundsPoint, bool, Vec<BoundsSegment>)>,
+}
+
+#[derive(Serialize)]
+struct PathBounds {
+    bounds: Bounds,
+    finite: bool,
+}
+
+impl PathAabbArgs {
+    fn bounds(self) -> Result<PathBounds, String> {
+        let mut bounds = Vec::new();
+        for (BoundsPoint(origin), _, segments) in self.path {
+            bounds.push(origin);
+            for mut segment in segments {
+                match segment.kind.as_str() {
+                    "l" => bounds.extend(segment.points),
+                    "c" if segment.points.len() == 3 => {
+                        let end = segment.points.pop().unwrap();
+                        let c2 = segment.points.pop().unwrap();
+                        let c1 = segment.points.pop().unwrap();
+                        bounds.extend(cubic_extrema(
+                            normalize_point3(bounds.last().unwrap().clone()),
+                            normalize_point3(end.clone()),
+                            normalize_point3(c1),
+                            normalize_point3(c2),
+                        )?);
+                        bounds.push(end);
+                    }
+                    "c" => return Err("A cubic requires three points".to_owned()),
+                    _ => {}
+                }
+            }
+        }
+        let finite = bounds
+            .iter()
+            .flatten()
+            .all(|coordinate| coordinate.is_finite());
+        Ok(PathBounds {
+            bounds: aabb(None, bounds)?,
+            finite,
+        })
+    }
+}
+
+/// Batch path-util.bounds and the existing AABB reducer without changing math.
+pub(super) fn path_aabb(input: &[u8]) -> Result<Vec<u8>, String> {
+    handle_cbor(input, PathAabbArgs::bounds)
+}
