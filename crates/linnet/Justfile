# Modules do not inherit the root backend variable; native recipes select auto.
develop := source_directory() / "../../scripts/develop.sh"

# Aliases for common commands

alias b := build
alias t := test
alias ta := test-all
alias c := check
alias ca := check-all
alias f := fmt
alias cl := clippy
alias w := wasm

default: wasm

# Build WASM target for linnest through the workspace Nix package
wasm:
    cd "{{ justfile_directory() }}/../.." && nix build .#linnest-wasm --print-build-logs

prepare-templates:
    cd {{ quote(source_directory() / "../..") }} && just sync-drawing-assets

# Build all workspace packages. Native builds embed existing Typst assets;
# refresh them explicitly with prepare-templates when needed.
build:
    bash {{ quote(develop) }} --backend auto build --workspace

build-clinnet:
    bash {{ quote(develop) }} --backend auto build -p clinnet

# Build release version
build-release:
    bash {{ quote(develop) }} --backend auto build --workspace --profile release --features serde

# Run tests for linnet package (default)
[positional-arguments]
test *args:
    bash {{ quote(develop) }} --backend auto test --package linnet --features serde "$@"

# Run tests for linnest package only
[positional-arguments]
test-linnest *args:
    bash {{ quote(develop) }} --backend auto test --package linnest "$@"

# Run all workspace tests with the recorded CI features
[positional-arguments]
test-all *args:
    bash {{ quote(develop) }} --backend auto test --workspace --features linnet/serde "$@"

# Quick check compilation for linnet (default)
check:
    bash {{ quote(develop) }} --backend auto check -p linnet --features serde

# Check linnest package
check-linnest:
    bash {{ quote(develop) }} --backend auto check -p linnest

# Check all packages with features
check-all:
    bash {{ quote(develop) }} --backend auto check --workspace --features serde

# Run binary with arguments
[positional-arguments]
run *args:
    bash {{ quote(develop) }} --backend auto run -p clinnet --bin linnet -- "$@"

# Format all code
fmt:
    bash {{ quote(develop) }} --backend auto fmt

# Run clippy linter with strict warnings
clippy:
    bash {{ quote(develop) }} --backend auto clippy --workspace --features serde -- -D warnings

# Clean build artifacts
clean:
    bash {{ quote(develop) }} --backend auto clean

# Build and open documentation
docs:
    bash {{ quote(develop) }} --backend auto doc --workspace --features serde --open

# Check documentation builds without warnings
check-docs:
    bash {{ quote(develop) }} --backend auto doc --workspace --features serde --no-deps

# Run benchmarks (default)
bench:
    cargo bench

# Run specific benchmark
bench-layout:
    cargo bench layout

# Development workflow: format, clippy, test
dev: fmt clippy test-all

# CI workflow: check, test, docs
ci: check-all test-all check-docs

# Insta snapshot commands
insta-review:
    cargo insta review

insta-accept:
    cargo insta accept

insta-test:
    cargo insta test

# Full release preparation
release-prep: fmt clippy test-all check-docs wasm

# =============================================================================
# Agent Notes
# =============================================================================

# Open agent notes for editing
notes:
    ${EDITOR:-vim} .agent/notes.md

# Open agent knowledge base
knowledge:
    ${EDITOR:-vim} .agent/README.md

# Quick note - add timestamped entry to notes
note text:
    echo "\n### $(date '+%Y-%m-%d %H:%M')" >> .agent/notes.md
    echo "{{ text }}" >> .agent/notes.md
    echo "" >> .agent/notes.md
