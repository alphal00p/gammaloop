        >>> incomplete = hep.IntegralFamily([k], [p], denominators[:1], kinematics=kin)
        >>> completed = incomplete.complete()
        >>> assert not incomplete.is_complete and completed.is_complete
        >>> assert completed.denominators[0] == denominators[0]
