        --------
        >>> FourMomentum(1.0, 1.0, 0.0, 0.0).rapidity()
        0.0
        """
    def delta_phi(self, other: FourMomentum) -> builtins.float:
        r"""
        Return the wrapped azimuthal separation from another momentum.

