    @property
    def px(self) -> builtins.float:
        r"""
        Return the x component.
        """
    @property
    def py(self) -> builtins.float:
        r"""
        Return the y component.
        """
    @property
    def pz(self) -> builtins.float:
        r"""
        Return the z component.
        """
    @property
    def norm_squared(self) -> builtins.float:
