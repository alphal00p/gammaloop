	5:26	-> 6:27	 [id=14 particle="g"];
	exte15	 [style=invis];
	8:28	-> exte15	 [id=15 is_cut="28" particle="e+"];
	exte16	 [style=invis];
	8:29	-> exte16	 [id=16 is_cut="29" particle="e-"];
}
