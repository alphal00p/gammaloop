digraph GL638{
    num = "1";
    overall_factor = "NumeratorDependentGrouping(638,1,(AutG(1))^(-1)*AntiFermionSpinSumSign(-1)*ExternalFermionOrderingSign(-1)*InternalFermionLoopSign(-1)*NumeratorIndependentSymmetryGrouping(2))+NumeratorDependentGrouping(639,1,(AutG(1))^(-1)*AntiFermionSpinSumSign(-1)*ExternalFermionOrderingSign(-1)*InternalFermionLoopSign(-1)*NumeratorIndependentSymmetryGrouping(2))";
    overall_factor_evaluated = "-4";
    projector = "u(1,spenso::bis(4,hedge(1)))*ubar(1,spenso::bis(4,hedge(29)))*v(0,spenso::bis(4,hedge(28)))*vbar(0,spenso::bis(4,hedge(0)))";
    // Higgs-aware threshold splitting on cut (2,6,10); all other cuts retain their
    // natural one-loop subspaces. Every explicit parent [3,6,7,10] preserves this cut.
    // A=(7,8), U=(8,12,14): [7] weight 1-W_H, [3,7] weight W_H.
    // F=(8,10,13,14): [7] weight 1-W_F, [3,7] weight W_F.
    // V=(3,7,14), P=(3,12), Z=(3,10,13) retain unit-weight [3,7] variants.
    // At each variant's cut-preserving star in the CM frame, Q=P0^0+P1^0,
    // H=eta(2,4,12), G0=eta(2,6,12,13), G4=eta(2,4,10,13):
    // W_H=H^2/(H^2+(P*Z/Q)^2), W_F=G0^2*G4^2/(G0^2*G4^2+P^2*Z^2).
    // The shared functions below avoid requiring foreign-cut surfaces in the local
    // catalogue. Off the host shell, wH/g0/g4 retain eta(foreign)-eta(2,6,10),
    // not eta(foreign) alone; wP=2E3-Q retains the original CM expression exactly.
    // The default dE function rationalizes energy differences to preserve soft cancellations.
    // W_H and its complement have explicit complementary values at their common zero.
    // This replaces the old (2,4,12) embedded projection that moved the opposite side.
    // The candidate passes the sampled soft/ordinary-threshold checks and generates
    // all 936 orientations with full UV. Exact coincident A/P radial roots still need
    // a stable combined-residue limit; generation and pilot runs do not certify it.
    // See docs/products/gammaloop/content/threshold-subtraction.typ for the prescription and limits.
    threshold_counterterms = "
schema_version = 1

[function_map]
\"wQ()\" = \"P(0,cind(0))+P(1,cind(0))\"
\"de46()\" = '''
dE(UFO::MT,UFO::MT,E(star,4),E(star,6),
   Q3(star,4,cind(1)),Q3(star,4,cind(2)),Q3(star,4,cind(3)),
   Q3(star,6,cind(1)),Q3(star,6,cind(2)),Q3(star,6,cind(3)))
'''
\"de3_10()\" = '''
dE(UFO::MT,UFO::MT,E(star,3),E(star,10),
   Q3(star,3,cind(1)),Q3(star,3,cind(2)),Q3(star,3,cind(3)),
   Q3(star,10,cind(1)),Q3(star,10,cind(2)),Q3(star,10,cind(3)))
'''
\"wH()\" = \"de46()+de3_10()\"
\"g0()\" = \"de3_10()+E(star,13)\"
\"g4()\" = \"de46()+E(star,13)\"
\"wP()\" = \"2*E(star,3)-wQ()\"
\"wZ()\" = \"E(star,3)+E(star,10)+E(star,13)-wQ()\"
\"denH()\" = \"wH()^2+(wP()*wZ()/wQ())^2\"
\"denF()\" = \"g0()^2*g4()^2+wP()^2*wZ()^2\"
\"WH()\" = \"if(denH(),wH()^2/denH(),0)\"
\"WHc()\" = \"if(denH(),(wP()*wZ()/wQ())^2/denH(),1)\"
\"WF()\" = \"g0()^2*g4()^2/denF()\"

[[cuts]]
edges = [2, 6, 10]

# The natural maximal subspace on this side is [3,7]. Its [7] variants supply
# the common-cycle LU partners on cuts (2,6,12,13) and (2,4,12), while the
# complementary [3,7] variants retain same-amplitude dual cancellation.

[[cuts.thresholds]]
edges = [7, 8]

[[cuts.thresholds.counterterms]]
name = \"shared_1l\"
subspace = [7]
parent_lmb = [3, 6, 7, 10]
[cuts.thresholds.counterterms.multiplier]
expression = \"WHc()\"

[[cuts.thresholds.counterterms]]
name = \"native_2l\"
subspace = [3, 7]
parent_lmb = [3, 6, 7, 10]
[cuts.thresholds.counterterms.multiplier]
expression = \"WH()\"

[[cuts.thresholds]]
edges = [8, 12, 14]

[[cuts.thresholds.counterterms]]
name = \"shared_1l\"
subspace = [7]
parent_lmb = [3, 6, 7, 10]
[cuts.thresholds.counterterms.multiplier]
expression = \"WHc()\"

[[cuts.thresholds.counterterms]]
name = \"native_2l\"
subspace = [3, 7]
parent_lmb = [3, 6, 7, 10]
[cuts.thresholds.counterterms.multiplier]
expression = \"WH()\"

[[cuts.thresholds]]
edges = [8, 10, 13, 14]

[[cuts.thresholds.counterterms]]
name = \"shared_1l\"
subspace = [7]
parent_lmb = [3, 6, 7, 10]
[cuts.thresholds.counterterms.multiplier]
expression = \"1-WF()\"

[[cuts.thresholds.counterterms]]
name = \"native_2l\"
subspace = [3, 7]
parent_lmb = [3, 6, 7, 10]
[cuts.thresholds.counterterms.multiplier]
expression = \"WF()\"

[[cuts.thresholds]]
edges = [3, 7, 14]

[[cuts.thresholds.counterterms]]
name = \"native_2l\"
subspace = [3, 7]
parent_lmb = [3, 6, 7, 10]

[[cuts.thresholds]]
edges = [3, 12]

[[cuts.thresholds.counterterms]]
name = \"native_2l\"
subspace = [3, 7]
parent_lmb = [3, 6, 7, 10]

[[cuts.thresholds]]
edges = [3, 10, 13]

[[cuts.thresholds.counterterms]]
name = \"native_2l\"
subspace = [3, 7]
parent_lmb = [3, 6, 7, 10]
";

	0 [int_id="V_141"];
	1 [int_id="V_141"];
