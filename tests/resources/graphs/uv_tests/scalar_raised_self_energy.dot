digraph scalar_raised_self_energy {
    num = 1
    edge [pdg=1001, num=1]
    node [num=1]

    ext0 [style=invis, is_cut=0]

    v2 -> ext0 [id=0]
    ext0 -> v3
    // Keep every factor on the propagator whose momentum it carries. The
    // repeated mink(4,1) index still contracts the edge-1 and edge-3 factors.
    v0 -> v1 [id=1, lmb_id=0, num="Q(1,spenso::mink(4,1))"]
    v0 -> v1 [id=2]
    v3 -> v0 [id=3, lmb_id=1, num="Q(3,spenso::mink(4,1))*Q(3,spenso::cind(0))"]
    v1 -> v2 [id=4, num="Q(4,spenso::cind(0))"]
    v2 -> v3 [id=5, num="Q(5,spenso::cind(0))"]
}
