digraph diagnostic_post_t_disconnected_poles {
    // Deliberately non-local algebraic input for the diagnostic-only 3Drep CLI:
    // this couples two disconnected components and must never serve as a
    // Feynman-rule or BPHZ-locality oracle.
    num = "(2*Q(2,spenso::mink(4,1))*Q(5,spenso::mink(4,1))+Q(5,spenso::mink(4,2))*Q(5,spenso::mink(4,2))-1)*(-Q(2,spenso::mink(4,3))*Q(5,spenso::mink(4,3)))"
    edge [particle="scalar_1" num=1]
    node [num=1]

    incoming [style=invis]
    outgoing [style=invis]
    incoming -> v0 [id=0 label="p1"]
    v0 -> v1 [id=2 lmb_id=0 label="k1"]
    v1 -> v2 [id=3 label="k1"]
    v2 -> v0 [id=4 label="k1-p1"]
    v2 -> outgoing [id=1 label="p1"]

    u0 -> u1 [id=5 lmb_id=1 label="k2"]
    u1 -> u2 [id=6 label="k2"]
    u2 -> u0 [id=7 label="k2"]
}
