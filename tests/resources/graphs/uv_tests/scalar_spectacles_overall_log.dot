digraph scalar_spectacles_overall_log { graph [projector=1]
    num = "-1𝑖/2"
    node [num = "1"]
    // Materialized from pinned main: every original scalar edge, including
    // the two external edges, carried the same propagator numerator i.
    edge [particle = scalar_1 num = "𝑖"]

    e [style = invis]

    e -> A:0 [id = 6 sink="{ufo_order:0}"]
    D:1 -> e [id = 7 source="{ufo_order:0}"]

    A -> B [id = 0 lmb_id = 0 source="{ufo_order:1}" sink="{ufo_order:0}"]
    A -> B [id = 1 source="{ufo_order:2}" sink="{ufo_order:1}"]
    B -> C [id = 2 source="{ufo_order:2}" sink="{ufo_order:0}"]
    C -> D [id = 3 lmb_id = 1 source="{ufo_order:1}" sink="{ufo_order:1}"]
    C -> D [id = 4 lmb_id = 2 source="{ufo_order:2}" sink="{ufo_order:2}"]
    D -> A [id = 5 sink="{ufo_order:3}" source="{ufo_order:3}"]
}
