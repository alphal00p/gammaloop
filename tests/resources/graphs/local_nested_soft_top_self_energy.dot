digraph local_nested_soft_top_self_energy {
  num = "1/3*spenso::g(spenso::dind(spenso::cof(3,gammalooprs::hedge(0))),spenso::cof(3,gammalooprs::hedge(1)))"
  ext [style=invis]

  ext -> v1:0 [id=0 particle=t]
  v4:1 -> ext [id=1 particle=t]
  // Use the outer carrier e2 and the child loop e3 as homogeneous loop
  // coordinates.  The derived e6 route differs by graph-external momentum;
  // selecting it would force an affine shift when the outer H operator acts
  // on the completed child atom.
  v1:2 -> v2:3 [id=2 particle=t lmb_id=0]
  v2:4 -> v3:5 [id=3 particle=t lmb_id=1]
  v2:6 -> v3:7 [id=4 particle=g]
  v3:8 -> v4:9 [id=5 particle=t]
  v1:10 -> v4:11 [id=6 particle=g]
}
