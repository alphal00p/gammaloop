digraph qqx_aaa_pentagon {
  overall_factor = "-1";
  overall_factor_evaluated = "-1";
  projector = "(3/4) * (1/3) * spenso::g(spenso::dind(spenso::cof(3,gammalooprs::hedge(1,1))),spenso::cof(3,gammalooprs::hedge(0,1))) 
                     * u(0,spenso::bis(4,hedge(0,1)))*vbar(1,spenso::bis(4,hedge(1,1)))
					 * ϵbar(2,spenso::mink(4,hedge(2,1)))
					 * ϵbar(3,spenso::mink(4,hedge(3,1)))
					 * ϵbar(4,spenso::mink(4,hedge(4,1))) ";
  //1𝑖
  // This is the complete numerator string
  // The user is free to also use here additional symbols, like
  num = "
 1
 * gammalooprs::Q(5,spenso::mink(4,gammalooprs::edge(5,1)))
 * gammalooprs::Q(6,spenso::mink(4,gammalooprs::edge(6,1)))
 * gammalooprs::Q(7,spenso::mink(4,gammalooprs::edge(7,1)))
 * gammalooprs::Q(8,spenso::mink(4,gammalooprs::edge(8,1)))
 * spenso::g(spenso::coad(8,gammalooprs::hedge(7,1)),spenso::coad(8,gammalooprs::hedge(8,1)))
 * spenso::g(spenso::cof(3,gammalooprs::hedge(10,1)),spenso::dind(spenso::cof(3,gammalooprs::hedge(11,1))))
 * spenso::g(spenso::cof(3,gammalooprs::hedge(11,1)),spenso::dind(spenso::cof(3,gammalooprs::hedge(12,1))))
 * spenso::g(spenso::cof(3,gammalooprs::hedge(12,1)),spenso::dind(spenso::cof(3,gammalooprs::hedge(13,1))))
 * spenso::g(spenso::cof(3,gammalooprs::hedge(13,1)),spenso::dind(spenso::cof(3,gammalooprs::hedge(14,1))))
 * spenso::g(spenso::cof(3,gammalooprs::hedge(5,1)),spenso::dind(spenso::cof(3,gammalooprs::hedge(6,1))))
 * spenso::g(spenso::cof(3,gammalooprs::hedge(6,1)),spenso::dind(spenso::cof(3,gammalooprs::hedge(9,1))))
 * spenso::g(spenso::cof(3,gammalooprs::hedge(9,1)),spenso::dind(spenso::cof(3,gammalooprs::hedge(10,1))))
 * spenso::g(spenso::mink(4,gammalooprs::hedge(7,1)),spenso::mink(4,gammalooprs::hedge(8,1)))
 * spenso::gamma(spenso::bis(4,gammalooprs::hedge(1,1)),spenso::bis(4,gammalooprs::hedge(14,1)),spenso::mink(4,gammalooprs::hedge(7,1)))
 * spenso::gamma(spenso::bis(4,gammalooprs::hedge(10,1)),spenso::bis(4,gammalooprs::hedge(9,1)),spenso::mink(4,gammalooprs::edge(6,1)))
 * spenso::gamma(spenso::bis(4,gammalooprs::hedge(11,1)),spenso::bis(4,gammalooprs::hedge(10,1)),spenso::mink(4,gammalooprs::hedge(3,1)))
 * spenso::gamma(spenso::bis(4,gammalooprs::hedge(12,1)),spenso::bis(4,gammalooprs::hedge(11,1)),spenso::mink(4,gammalooprs::edge(7,1)))
 * spenso::gamma(spenso::bis(4,gammalooprs::hedge(13,1)),spenso::bis(4,gammalooprs::hedge(12,1)),spenso::mink(4,gammalooprs::hedge(4,1)))
 * spenso::gamma(spenso::bis(4,gammalooprs::hedge(14,1)),spenso::bis(4,gammalooprs::hedge(13,1)),spenso::mink(4,gammalooprs::edge(8,1)))
 * spenso::gamma(spenso::bis(4,gammalooprs::hedge(5,1)),spenso::bis(4,gammalooprs::hedge(0,1)),spenso::mink(4,gammalooprs::hedge(8,1)))
 * spenso::gamma(spenso::bis(4,gammalooprs::hedge(6,1)),spenso::bis(4,gammalooprs::hedge(5,1)),spenso::mink(4,gammalooprs::edge(5,1)))
 * spenso::gamma(spenso::bis(4,gammalooprs::hedge(9,1)),spenso::bis(4,gammalooprs::hedge(6,1)),spenso::mink(4,gammalooprs::hedge(2,1)))
 * spenso::t(spenso::coad(8,gammalooprs::hedge(7,1)),spenso::cof(3,gammalooprs::hedge(14,1)),spenso::dind(spenso::cof(3,gammalooprs::hedge(1,1))))
 * spenso::t(spenso::coad(8,gammalooprs::hedge(8,1)),spenso::cof(3,gammalooprs::hedge(0,1)),spenso::dind(spenso::cof(3,gammalooprs::hedge(5,1))))
"; 

  // When opting to supply the whole numerator in the above, then remove the localized numerator specification per edge by uncommenting this
  edge [ num="1" dod=-100]
  // When opting to supply the whole numerator in the above, then remove the localized numerator specification per node by uncommenting this
  node [ num="1" dod=-100]

  ext   [style=invis];

  ext	-> 0:0	 [id=0 particle="d"];
  ext	-> 1:1	 [id=1 particle="d~"];
  2:2	-> ext	 [id=2 particle="a"];
  3:3	-> ext	 [id=3 particle="a"];
  4:4	-> ext   [id=4 particle="a"];

  0	-> 2	 [id=5 particle="d"];
  2	-> 3	 [id=6 particle="d"];
  3	-> 4	 [id=7 particle="d"];
  4 -> 1     [id=8 particle="d"];
  // 1 -> 0     [id=9 lmb_id="0" particle="g"];
  // The option below would introduce an IR regulator
  1 -> 0     [id=9 lmb_id="0" particle="g" mass="0.01"];

}

