digraph paper_appendix_b1_nested_gluon_self_energy {
  // Eq. (B.1): a massive-quark gluon self-energy with a nested
  // massive-quark/massless-gluon fermion self-energy.  The graph-level
  // projector closes both external adjoint colour and Lorentz indices.
  projector = "1/8*spenso::g(spenso::coad(8,gammalooprs::hedge(0)),spenso::coad(8,gammalooprs::hedge(1)))*spenso::g(spenso::mink(4,gammalooprs::hedge(0)),spenso::mink(4,gammalooprs::hedge(1)))"
  ext [style=invis]

  ext -> v_mu:0 [id=0 particle=g]
  v_nu:1 -> ext [id=1 particle=g]

  // Use the loop coordinates of Appendix B: GammaLoop edges e2 and e3 carry
  // p and k.  These are GL IDs, not the paper's edge labels; internally the
  // map is GL e2->paper e2, e3->e4, e4->e5, e5->e3 and e6->e1.  Choosing the
  // derived lines k-p and p-q instead would make the child boundary an affine
  // loop coordinate when the outer operator acts on the completed child atom.
  v_mu:2 -> self_energy_in:3 [id=2 particle=t lmb_id=0]
  self_energy_in:4 -> self_energy_out:5 [id=3 particle=t lmb_id=1]
  self_energy_in:6 -> self_energy_out:7 [id=4 particle=g]
  self_energy_out:8 -> v_nu:9 [id=5 particle=t]
  v_nu:10 -> v_mu:11 [id=6 particle=t]
}
