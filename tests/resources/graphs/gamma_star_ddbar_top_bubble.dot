digraph top_bubble_vertex {
  // The singlet projector closes the otherwise-open fundamental colour line.
  num = "1/3*spenso::g(spenso::dind(spenso::cof(3,gammalooprs::hedge(0))),spenso::cof(3,gammalooprs::hedge(1)))"
  ext [style=invis]

  v1:0 -> ext [id=0 particle="d~"]
  v3:1 -> ext [id=1 particle=d]
  ext -> v2:2 [id=2 particle=a]

  v1:3 -> v2:4 [id=3 particle=d]
  v2:5 -> v3:6 [id=4 particle=d]
  v3:7 -> t1:8 [id=5 particle=g]
  t2:9 -> v1:10 [id=6 particle=g lmb_id=0]
  t1:11 -> t2:12 [id=7 particle=t]
  t2:13 -> t1:14 [id=8 particle=t lmb_id=1]
}
