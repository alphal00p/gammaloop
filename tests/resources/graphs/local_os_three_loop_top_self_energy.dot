digraph local_os_three_loop_top_self_energy {
  // The component numerator stays open; scalar amplitudes attach the native
  // external fermion states only during final integrand assembly.
  // A two-loop massive-quark self-energy, itself containing a one-loop
  // massive-quark self-energy, inserted in a third quark self-energy loop.
  // The initial direct-source check leaves the outer loop as a spectator.
  num = "1/3*spenso::g(spenso::dind(spenso::cof(3,gammalooprs::hedge(0))),spenso::cof(3,gammalooprs::hedge(1)))"
  ext [style=invis]

  ext -> v_mu:0 [id=0 particle=t]
  v_nu:1 -> ext [id=1 particle=t]

  // Homogeneous carriers e2=p, e3=k and e4=l are compatible across both
  // nested fermion components. The two gluon momenta are l-k and k-p up to
  // their edge orientations; no affine loop-coordinate shift is required.
  v_mu:2 -> parent_in:3 [id=2 particle=t lmb_id=0]
  parent_in:4 -> child_in:5 [id=3 particle=t lmb_id=1]
  child_in:6 -> child_out:7 [id=4 particle=t lmb_id=2]
  child_in:8 -> child_out:9 [id=5 particle=g]
  child_out:10 -> parent_out:11 [id=6 particle=t]
  parent_in:12 -> parent_out:13 [id=7 particle=g]
  parent_out:14 -> v_nu:15 [id=8 particle=t]
  v_mu:16 -> v_nu:17 [id=9 particle=g]

  // Primitive OS child: {e4,e5}, incoming e3 and outgoing spinor hedge10.
  // Proper two-loop OS parent: {e3,e4,e5,e6,e7}, incoming e2 and hedge14.
  // The spectator e2/e8/e9 momenta remain live at the parent's fixed point.
  // The complete three-loop parent is also a massive-quark OS component.
}
