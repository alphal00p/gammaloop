digraph local_disjoint_os_top_self_energies {
  // Vertex-disjoint one-loop quark self-energies on a common physical line.
  // The live bridge e4 retains p even when the two child subtraction points
  // independently evaluate their own boundary copies at sigma*m*(1,0,0,0).
  num = "1/3*spenso::g(spenso::dind(spenso::cof(3,gammalooprs::hedge(0))),spenso::cof(3,gammalooprs::hedge(1)))"
  ext [style=invis]

  ext -> left_in:0 [id=0 particle=t]
  right_out:1 -> ext [id=1 particle=t]
  left_in:2 -> left_out:3 [id=2 particle=t lmb_id=0]
  left_in:4 -> left_out:5 [id=3 particle=g]
  left_out:6 -> right_in:7 [id=4 particle=t]
  right_in:8 -> right_out:9 [id=5 particle=t lmb_id=1]
  right_in:10 -> right_out:11 [id=6 particle=g]
}
