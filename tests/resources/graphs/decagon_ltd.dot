// arXiv:1906.06138, Appendix B.1: p_i enters between k_(i-1) and k_i.
// All external momenta are incoming; k_n is the loop momentum.
digraph decagon {
    gammaloop_runtime=1;
    overall_factor=1; num=1; projector=1;
    node [num=1];
    edge [num=1];
    v01 -> v02 [id=0 mass="1/10" source="{ufo_order:0}" sink="{ufo_order:0}"];
    v02 -> v03 [id=1 mass="2/10" source="{ufo_order:1}" sink="{ufo_order:0}"];
    v03 -> v04 [id=2 mass="3/10" source="{ufo_order:1}" sink="{ufo_order:0}"];
    v04 -> v05 [id=3 mass="4/10" source="{ufo_order:1}" sink="{ufo_order:0}"];
    v05 -> v06 [id=4 mass="5/10" source="{ufo_order:1}" sink="{ufo_order:0}"];
    v06 -> v07 [id=5 mass="6/10" source="{ufo_order:1}" sink="{ufo_order:0}"];
    v07 -> v08 [id=6 mass="7/10" source="{ufo_order:1}" sink="{ufo_order:0}"];
    v08 -> v09 [id=7 mass="8/10" source="{ufo_order:1}" sink="{ufo_order:0}"];
    v09 -> v10 [id=8 mass="9/10" source="{ufo_order:1}" sink="{ufo_order:0}"];
    v10 -> v01 [id=9 mass="10/10" lmb_id=0 source="{ufo_order:1}" sink="{ufo_order:1}"];
    p01 [style=invis];
    p01 -> v01 [id=10 particle=scalar_0 mass=0 sink="{ufo_order:2}"];
    p02 [style=invis];
    p02 -> v02 [id=11 particle=scalar_0 mass=0 sink="{ufo_order:2}"];
    p03 [style=invis];
    p03 -> v03 [id=12 particle=scalar_0 mass=0 sink="{ufo_order:2}"];
    p04 [style=invis];
    p04 -> v04 [id=13 particle=scalar_0 mass=0 sink="{ufo_order:2}"];
    p05 [style=invis];
    p05 -> v05 [id=14 particle=scalar_0 mass=0 sink="{ufo_order:2}"];
    p06 [style=invis];
    p06 -> v06 [id=15 particle=scalar_0 mass=0 sink="{ufo_order:2}"];
    p07 [style=invis];
    p07 -> v07 [id=16 particle=scalar_0 mass=0 sink="{ufo_order:2}"];
    p08 [style=invis];
    p08 -> v08 [id=17 particle=scalar_0 mass=0 sink="{ufo_order:2}"];
    p09 [style=invis];
    p09 -> v09 [id=18 particle=scalar_0 mass=0 sink="{ufo_order:2}"];
    p10 [style=invis];
    p10 -> v10 [id=19 particle=scalar_0 mass=0 sink="{ufo_order:2}"];
}
