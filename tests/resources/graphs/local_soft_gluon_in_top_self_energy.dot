digraph local_soft_gluon_in_top_self_energy {
  projector = "1" // The self-energy has open external spinor ports.
  // A quark-loop gluon self-energy inside a massive-quark self-energy.
  // The gluon carrier e2 is the outer loop coordinate p, so the child soft
  // point p=0 is independent of the outer fermion subtraction momentum q.
  num = "1/3*spenso::g(spenso::dind(spenso::cof(3,gammalooprs::hedge(0))),spenso::cof(3,gammalooprs::hedge(1)))"
  ext [style=invis]

  ext -> v1:0 [id=0 particle=t]
  v4:1 -> ext [id=1 particle=t]
  v1:2 -> v2:3 [id=2 particle=g lmb_id=0]
  v2:4 -> v3:5 [id=3 particle=t lmb_id=1]
  v3:6 -> v2:7 [id=4 particle=t]
  v3:8 -> v4:9 [id=5 particle=g]
  v1:10 -> v4:11 [id=6 particle=t]
}
