digraph fermi_triple_pole { graph [projector=1]
    // A repeated massive fermion pole, with constant local numerators.
    // The third-order pole produces both a Fermi delta and its derivative.
    node [num=1];
    edge [num=1 particle="b"];
    A -> B [id=0 lmb_id=0 source="{ufo_order:0}" sink="{ufo_order:0}"];
    B -> C [id=1 source="{ufo_order:1}" sink="{ufo_order:0}"];
    C -> A [id=2 sink="{ufo_order:1}" source="{ufo_order:1}"];
}
