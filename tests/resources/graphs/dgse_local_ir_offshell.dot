digraph se {

num = "spenso::g(spenso::dind(spenso::cof(3,hedge(0))),spenso::cof(3,hedge(100)))*spenso::g(spenso::dind(spenso::cof(3,hedge(101))),spenso::cof(3,hedge(1)))*spenso::t(spenso::coad(8,hedge(2)),spenso::cof(3,hedge(101)),spenso::dind(spenso::cof(3,hedge(100))))"

ext    [style=invis]
ext -> v1:0 [particle=d];
ext -> v5:2 [particle=g];
v4:1 -> ext [particle=d];
// Keep the soft carrier and the nested self-energy loop as homogeneous
// full-graph loop coordinates. This prevents a parent replay from promoting
// an affine child boundary carrier.
v1 -> v2[ id=0 particle=d lmb_id=0];
v2 -> v3[particle=d lmb_id=1];
v3 ->v4 [ id=1 particle=d];

v1 -> v5 -> v4 [particle=g];

v2 -> v3  [particle=g];
}
