          "vakint_symbol": {
            "id": "vakint_symbol",
            "name": "vakint_symbol!",
            "title": "Vakint symbol parser",
            "kind": "exported-macro",
            "supported": true,
            "required_features": [],
            "docs": {
              "format": "rust-markdown",
              "body": "Resolves a symbol name in Vakint's namespace while preserving an explicit namespace."
            },
            "summary": "Resolves a symbol name in Vakint's namespace while preserving an explicit namespace.",
            "signature": "#[macro_export] macro_rules! vakint_symbol\n{\n    ($s: expr) =>\n    {{\n            if\n            format!(\"{}\",\n            $s).starts_with(format!(\"{}::\", $crate::NAMESPACE).as_str())\n            {\n                match symbolica::try_parse!($s)\n                {\n                    Ok::<_, String>(a) => match a\n                    {\n                        symbolica::atom::Atom::Var(sym) => sym.get_symbol(), _ =>\n                        panic!(\"Parsed atom is not a symbol: {}.\", $s),\n                    }, Err(e) =>\n                    panic!(\"Could not parse symbol from string: {}, Error: {}\",\n                    $s, e),\n                }\n            } else\n            {\n                match\n                symbolica::try_parse!(format!(\"{}\", $s), default_namespace =\n                $crate::NAMESPACE)\n                {\n                    Ok::<_, String>(a) => match a\n                    {\n                        symbolica::atom::Atom::Var(sym) => sym.get_symbol(), _ =>\n                        panic!(\"Parsed atom is not a symbol: {}.\", $s),\n                    }, Err(e) =>\n                    panic!(\"Could not parse symbol from string: {}, Error: {}\",\n                    $s, e),\n                }\n            }\n        }};\n}",
            "since": null,
            "keywords": [],
            "params": [],
            "returns": null,
            "examples": [
              {
                "title": "Supported usage",
                "language": "rust",
                "code": "let symbol = vakint::vakint_symbol!(\"mass\");"
              }
            ],
            "members": [],
            "source": {
              "identifier": "vakint::vakint_symbol",
              "file": "crates/vakint/src/utils.rs",
              "line": 76,
              "column": 1
            }
          },
