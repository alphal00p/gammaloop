ash so stripping feynkit preserves feynkit-cff.\nfor artifact in target/ci-optim/{.fingerprint,build}/feynkit-generator-*; do\n  if [[ \"${artifact##*/}\" =~ ^feynkit-generator-[0-9a-f]+$ ]]; then\n    rm -rf \"$artifact\"\n  fi\ndone\n\n# Match the whole hash so stripping feynkit preserves feynkit-cff.\nfor artifact in target/ci-optim/{.fingerprint,build}/feynkit_generator-*; do\n  if [[ \"${artifact##*/}\" =~ ^feynkit_generator-[0-9a-f]+$ ]]; then\n    rm -rf \"$artifact\"\n  fi\ndone\n\n\n","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/1j4yxsr4511mwi9jn9b4dg7wh3xb150p-source","stdenv":"/nix/store/dp0zdsysxsli2xncj4prvhsik08qn697-stdenv-linux","strictDeps":"1","system":"x86_64-linux","version":"0.1.0"},"inputs":{"drvs":{"2myvy91vqxv75ly150dmr1xdxq7s1xzx-cargoHelperFunctionsHook.drv":{"dynamicOutputs":{},"outputs":["out"]},"2s23ryz978zfz50g5lshw45046sq6s17-libmpc-1.4.1.drv":{"dynamicOutputs":{},"outputs":["out"]},"3qi1xl0dniaww0r6lqjfpkf8ghyyznfc-configureCargoVendoredDepsHook.drv":{"dynamicOutputs":{},"outputs":["out"]},"71gxnaixis3nn5xr1ql6y9dnmc5p1n85-gcc-15.3.0.drv":{"dynamicOutputs":{},"outputs":["lib"]},"b28dayrl3q5md35690vj61wrax0kys29-python3-3.13.15.drv":{"dynamicOutputs":{},"outputs":["out"]},"c2ri023wzq86jp4hkssh364s9ir7hd6m-installCargoArtifactsHook.drv":{"dynamicOutputs":{},"outputs":["out"]},"d3pcn22bk2x92qygnwxzjvvx374y9djx-configureCargoCommonVarsHook.drv":{"dynamicOutputs":{},"outputs":["out"]},"fjz2cw1qxpgrynvck61l4i6wi0xizdrd-openssl-3.6.4.drv":{"dynamicOutputs":{},"outputs":["dev","out"]},"hfjpj2pkl74h19ff12r3r2shwzsk60fl-gammaloop-crate-feynkit-generator-dependency-inputs.drv":{"dynamicOutputs":{},"outputs":["out"]},"i55xmgcpg5jfbhbf0y0l6z7g41a602a2-pkg-config-wrapper-0.29.2.drv":{"dynamicOutputs":{},"outputs":["out"]},"i7kzidyvlpn4lw902j61l86ads8kajb0-crane-dummy-cargo-target.rs.drv":{"dynamicOutputs":{},"outputs":["out"]},"k6r1fls6xj07v3b9phdnv231j7bddssm-inheritCargoArtifactsHook.drv":{"dynamicOutputs":{},"out