  "exact_task_commands": {
    "build.sh": "set -u\nif [ -z \"${SYMBOLICA_LICENSE:-}\" ]; then export SYMBOLICA_LICENSE=\"$(cat \"${XDG_CONFIG_HOME:-$HOME/.config}/symbolica/license\")\"; fi\nexport CARGO_BUILD_JOBS=2 RAYON_NUM_THREADS=2 INSTA_UPDATE=no\nnix develop /nix/store/b53dxkf559x6hivvnamqs4kzh91d8ar5-nix-shell-env.drv -c bash -c '\nset -eu\ncargo run --locked --profile ci-optim -p alphal00p-docs-python-exporter --features feynkit -- feynkit-community docs/api/python/feynkit-community.pyi > target/wp3-units39-43/stub-generate.log 2>&1\ncp docs/api/python/feynkit-community.pyi crates/feynkit-py/python/symbolica/community/hepkit/__init__.pyi\ncp docs/api/python/feynkit-community.pyi examples/notebooks/symbolica-host/python/symbolica/community/hepkit/__init__.pyi\ncargo nextest list --locked --cargo-profile ci-optim -p feynkit-generator -p linnet -p feynkit-py --message-format json > target/wp3-units39-43/core-binaries.json 2> target/wp3-units39-43/core-build.log\ncargo nextest list --locked --cargo-profile ci-optim -p gammaloop-integration-tests --test test_feyngen --message-format json > target/wp3-units39-43/cli-binaries.json 2> target/wp3-units39-43/cli-build.log\ncargo build --locked --profile ci-optim -p feynkit-generator --example four_loop_numerator --message-format=json > target/wp3-units39-43/four-loop-build.jsonl 2> target/wp3-units39-43/four-loop-build.log\n'\nrc=$?; printf '%s\\n' \"$rc\" > target/wp3-units39-43/build.exit;exit \"$rc\"\n",
    "test-final.sh": "set -u\nif [ -z \"${SYMBOLICA_LICENSE:-}\" ]; then export SYMBOLICA_LICENSE=\"$(cat \"${XDG_CONFIG_HOME:-$HOME/.config}/symbolica/license\")\"; fi\nexport CARGO_BUILD_JOBS=2 RAYON_NUM_THREADS=2 INSTA_UPDATE=no FEYNKIT_ORACLE_THREADS=1,8,32\nunset INSTA_FORCE_PASS FEYNKIT_ORACLE_RECORD FEYNKIT_ORACLE_DUMP\nnix develop /nix/store/b53dxkf559x6hivvnamqs4kzh91d8ar5-nix-shell-env.drv -c bash -c '\nset -eu\ncargo nextest run --locked --cargo-profile ci-optim -P ci_gammaloop -p feynkit-py --no-fail-fast > target/wp3-units39-43/python-native-final.log 2>&1\ncargo nextest run --locked --cargo-profile ci-optim -P ci_gammaloop -p linnet -E \"test(canon::tests::) | test(terminal_free) | test(pocket)\" --no-fail-fast > target/wp3-units39-43/linnet.log 2>&1\ncargo nextest run --locked --cargo-profile ci-optim -P ci_gammaloop -p feynkit-generator --lib -E \"test(grouping::tests::) | test(canonical) | test(physical_frame) | test(anchored) | test(cut_partitions) | test(terminal)\" --no-fail-fast > target/wp3-units39-43/generator.log 2>&1\ncargo nextest run --locked --cargo-profile ci-optim -P ci_gammaloop -p feynkit-generator --lib --run-ignored only -E \"test(=grouping::tests::vacuum_group28_original_pair_identity)\" > target/wp3-units39-43/B2.log 2>&1\ncargo nextest run --locked --cargo-profile ci-optim -P ci_gammaloop -p feynkit-model -p feynkit-graph -E \"test(/(template|admission|hidden|history|localization|anonymous|nonidentity|collision|raw_rule|gauge_sewing)/)\" --no-fail-fast > target/wp3-units39-43/admission.log 2>&1\ncargo nextest run --locked --cargo-profile ci-optim -P ci_gammaloop -p feynkit-generator --test generation_oracle -E \"test(frames::)\" --no-fail-fast > target/wp3-units39-43/frames.log 2>&1\ncargo nextest run --locked --cargo-profile ci-optim -P ci_gammaloop -p feynkit-generator --test generation_oracle -E \"test(outputs_do_not_depend_on_index_registration_order_) | test(=index_registration_child_failure_propagates) | test(=ym_ggg_zero_color_L3) | test(=xs_qcdqed_addx_canonical_scalar_lr_L3)\" --no-fail-fast > target/wp3-units39-43/oracle.log 2>&1\ncargo nextest run --locked --cargo-profile ci-optim -P ci_full -p gammaloop-integration-tests --test test_feyngen --ignore-default-filter -E \"test(=failing::test_generate_aa_ttx_cross_section_slow_filter) | test(=test_vacuum_amplitude_generation_full_sm_three_loop_filtered)\" --no-fail-fast > target/wp3-units39-43/cli.log 2>&1\nfor threads in 1 8 32; do\n target/ci-optim/examples/four_loop_numerator \"$threads\" - true > \"target/wp3-units39-43/four-loop-$threads.log\" 2>&1\ndone\n'\nrc=$?;printf '%s\\n' \"$rc\" > target/wp3-units39-43/test-final.exit;exit \"$rc\"\n",
    "docs.sh": "set -eu\nnix develop /nix/store/b53dxkf559x6hivvnamqs4kzh91d8ar5-nix-shell-env.drv -c bash -c '\nset -eu\npython3 target/wp3-units39-43/audit.py > target/wp3-units39-43/registry.log\ncargo fmt --all --check > target/wp3-units39-43/format.log 2>&1\nfor note in generation-integration-units39-43 generation-frame-certificate generation-frame-migration generation-pocket-weight-migration generation-integration-plan; do\n typst compile --features html --root . --creation-timestamp 0 docs/architecture/$note.typ target/wp3-units39-43/$note.pdf > target/wp3-units39-43/$note-pdf.log 2>&1\n printf \"#document(\\\"index.html\\\")[#include \\\"/docs/architecture/%s.typ\\\"]\\n\" \"$note\" > target/wp3-units39-43/$note-wrapper.typ\n typst compile --features html,bundle --format bundle --root . --creation-timestamp 0 target/wp3-units39-43/$note-wrapper.typ target/wp3-units39-43/$note-html > target/wp3-units39-43/$note-html.log 2>&1\ndone\n'\nprintf '0\\n' > target/wp3-units39-43/docs.exit\n",
    "wasm-build.sh": "set -u\nuri='git+file:///shared/lcnbr/dev/gammaloop/main?rev=66c2aed45d83b54f55b39bf2fc2f88c2066d6343&shallow=1&allRefs=1'\nnix build --no-link --print-out-paths --cores 2 --max-jobs 1 \"$uri#linnest-wasm\" > target/wp3-units39-43/wasm-output.txt 2> target/wp3-units39-43/wasm-build.log\nrc=$?;printf '%s\\n' \"$rc\" > target/wp3-units39-43/wasm-build.exit;exit \"$rc\"\n"
  },
