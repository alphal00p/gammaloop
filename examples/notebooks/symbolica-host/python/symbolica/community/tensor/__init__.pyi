        >>> tensor = Tensor.dense(A, [1.0, 2.0, 3.0, 4.0])
        >>> from symbolica.community.tensor import TensorNetwork
        >>> network = TensorNetwork(tensor)
        >>> indexed = network.index("i", "j")
        >>> indexed.rank
        2
