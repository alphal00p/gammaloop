def dot(left: TensorExpression | Expression, right: TensorExpression | Expression) -> TensorExpression:
    r"""
    Contract two rank-one tensors into a scalar product.

    Parameters
    ----------
    left, right : TensorExpression, Tensor, or TensorNetwork
