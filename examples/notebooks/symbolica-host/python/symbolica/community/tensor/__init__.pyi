    --------
    >>> from symbolica import S
    >>> from symbolica.community.tensor import Tensor, TensorName, Representation
    >>> x = S("x")
    >>> values = Tensor.dense(TensorName.vector("eval_v")(Representation.euc(2)), [x, x**2])
