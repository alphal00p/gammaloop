+    fn insert_factor_across_header_widths() {
+        let x = parse!("x");
+        let y = parse!("y");
+        let coefficient = Atom::num(2);
+        let mut large = Fun::new_into(symbol!("large_inserted_factor"), Vec::new());
+        large.add_args(&vec![x.as_view(); 22000]);
+        for count in [1, 2, 84, 85, 254, 255, 256, 21844, 65534, 65535] {
+            for has_coefficient in [false, true] {
+                let mut factors = Vec::new();
+                if has_coefficient {
+                    factors.push(coefficient.as_view());
+                }
+                factors.extend(vec![x.as_view(); count]);
+                let mut source = Mul::new();
+                for &factor in &factors {
+                    source.extend(factor);
+                }
+                source.set_has_coefficient(has_coefficient);
+                // Cover argument-count boundaries and, independently, payload
+                // growth that widens a packed byte-length header.
+                for inserted in [y.as_view(), large.as_view()] {
+                    for index in [
+                        usize::from(has_coefficient),
+                        factors.len() / 2,
+                        factors.len(),
+                    ] {
+                        let index = index.max(usize::from(has_coefficient));
+                        let offset = factors[..index].iter().map(|a| a.get_data().len()).sum();
+                        let mut product = source.clone();
+                        product.insert_factor(offset, inserted);
+                        let mut expected = factors.clone();
+                        expected.insert(index, inserted);
+                        check_list(product.as_view(), &expected);
+                        let mut fresh = Mul::new();
+                        for &factor in &expected {
+                            fresh.extend(factor);
+                        }
+                        fresh.set_has_coefficient(has_coefficient);
+                        assert_eq!(product.as_view(), fresh.as_view());
+                        assert_eq!(product.to_mul_view().has_coefficient(), has_coefficient);
+                    }
+                }
+                if !has_coefficient {
+                    let mut product = source.clone();
+                    product.insert_factor(0, coefficient.as_view());
+                    product.set_has_coefficient(true);
+                    let mut fresh = Mul::new();
+                    fresh.extend(coefficient.as_view());
+                    fresh.extend(source.as_view());
+                    fresh.set_has_coefficient(true);
+                    assert_eq!(product.as_view(), fresh.as_view());
+                    assert_eq!(
+                        product.to_mul_view().get_coefficient(),
+                        Some(coefficient.as_view())
+                    );
+                }
+            }
