+        let scaled = if let (Some(left), Some(right)) = (coefficient, rhs_coefficient) {
+            let scaled = workspace.new_num(left.get_coeff_view() * right.get_coeff_view());
+            if scaled.is_zero() || scaled.is_one() {
+                return false;
+            }
+            Some(scaled)
+        } else {
+            None
+        };
