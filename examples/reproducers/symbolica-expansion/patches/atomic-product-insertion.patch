+    /// Insert one factor at a byte offset in the factor payload. The offset must
+    /// lie at a factor boundary; `other` must not be a product. Like `extend`,
+    /// this leaves normalization and the coefficient flag to the caller.
+    pub(crate) fn insert_factor(&mut self, offset: usize, other: AtomView<'_>) {
+        debug_assert!(!matches!(other, AtomView::Mul(_)));
+        let (n_args, _, payload) = read_packed_pair(&self.data[1..]);
+        assert!(offset <= payload.len());
+        let old_end = self.data.len() - payload.len();
+        let position = old_end + offset;
+        let inserted = other.get_data();
+        let old_len = self.data.len();
+        self.data[0] |= NOT_NORMALIZED;
+        self.data.resize(old_len + inserted.len(), 0);
+        self.data
+            .copy_within(position..old_len, position + inserted.len());
+        self.data[position..position + inserted.len()].copy_from_slice(inserted);
+        update_list_header(&mut self.data, old_end, n_args + 1);
     }
 
