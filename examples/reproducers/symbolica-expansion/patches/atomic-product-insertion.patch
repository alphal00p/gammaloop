+    /// Insert one atomic factor, with an optional exact coefficient, into an
+    /// already normalized product. Reject inputs needing factor merging or
+    /// coefficient removal so their existing deferred normalization is retained.
+    fn try_mul_atomic_prefix(
+        &self,
+        rhs: AtomView<'_>,
+        workspace: &Workspace,
+        out: &mut Atom,
+    ) -> bool {
+        let AtomView::Mul(rhs) = rhs else {
+            return false;
+        };
+        if !rhs.is_normalized() {
+            return false;
+        }
+        let (factor, coefficient) = match *self {
+            factor @ (AtomView::Var(_) | AtomView::Fun(_)) => (Some(factor), None),
+            AtomView::Num(coefficient) => (None, Some(coefficient)),
+            AtomView::Mul(prefix) if prefix.get_nargs() == 2 => {
+                // Expansion assembles this prefix before reaching the first
+                // sum. Validate its children without normalizing it eagerly.
+                let mut args = prefix.iter();
+                match (args.next().unwrap(), args.next().unwrap()) {
+                    (
+                        AtomView::Num(coefficient),
+                        factor @ (AtomView::Var(_) | AtomView::Fun(_)),
+                    )
+                    | (
+                        factor @ (AtomView::Var(_) | AtomView::Fun(_)),
+                        AtomView::Num(coefficient),
+                    ) => (Some(factor), Some(coefficient)),
+                    _ => return false,
+                }
+            }
+            _ => return false,
+        };
+        if factor.is_some_and(|factor| factor.needs_normalization()) {
+            return false;
+        }
+        if coefficient.is_some_and(|coefficient| {
+            !matches!(
+                coefficient.get_coeff_view(),
+                CoefficientView::Natural(..) | CoefficientView::Large(..)
+            ) || coefficient.is_zero()
+        }) {
+            return false;
+        }
+        let coefficient = coefficient.filter(|coefficient| !coefficient.is_one());
+        let mut args = rhs.iter();
+        let mut offset = 0;
+        let rhs_coefficient = if rhs.has_coefficient() {
+            let Some(AtomView::Num(coefficient)) = args.next() else {
+                return false;
+            };
+            if !matches!(
+                coefficient.get_coeff_view(),
+                CoefficientView::Natural(..) | CoefficientView::Large(..)
+            ) {
+                return false;
+            }
+            offset += coefficient.as_view().get_data().len();
+            Some(coefficient)
+        } else {
+            None
+        };
+        let mut insertion = None;
+        for existing in args {
+            if !matches!(existing, AtomView::Var(_) | AtomView::Fun(_)) {
+                return false;
+            }
+            if let Some(factor) = factor {
+                match factor.cmp_factors(&existing) {
+                    std::cmp::Ordering::Equal => return false,
+                    std::cmp::Ordering::Less if insertion.is_none() => insertion = Some(offset),
+                    _ => {}
+                }
+            }
+            offset += existing.get_data().len();
+        }
