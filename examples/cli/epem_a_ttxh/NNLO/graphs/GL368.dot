digraph GL368{
    // Retain native two-loop charts at competing hard thresholds, and share
    // one-loop charts across soft-related cuts through complementary weights.
    threshold_counterterms = "
schema_version = 1

[function_map]
\"BL()\" = \"E(star,3)+E(star,5)+E(star,11)+E(star,14)-wQ()\"
\"BR()\" = \"E(star,4)+E(star,6)+E(star,11)+E(star,14)-wQ()\"
\"NL()\" = \"if(denL(),dL()^2/denL(),1)\"
\"NR()\" = \"if(denR(),dR()^2/denR(),1)\"
\"SL()\" = \"if(denL(),pL()^2/denL(),0)\"
\"SR()\" = \"if(denR(),pR()^2/denR(),0)\"
\"dL()\" = \"dE(UFO::MT,UFO::MT,E(star,4),E(star,14),Q3(star,4,cind(1)),Q3(star,4,cind(2)),Q3(star,4,cind(3)),Q3(star,14,cind(1)),Q3(star,14,cind(2)),Q3(star,14,cind(3)))+E(star,12)\"
\"dR()\" = \"dE(UFO::MT,UFO::MT,E(star,3),E(star,11),Q3(star,3,cind(1)),Q3(star,3,cind(2)),Q3(star,3,cind(3)),Q3(star,11,cind(1)),Q3(star,11,cind(2)),Q3(star,11,cind(3)))+E(star,13)\"
\"denL()\" = \"dL()^2+pL()^2\"
\"denR()\" = \"dR()^2+pR()^2\"
\"pL()\" = \"BL()*E(star,13)/wQ()\"
\"pR()\" = \"BR()*E(star,12)/wQ()\"
\"wQ()\" = \"P(0,cind(0))+P(1,cind(0))\"

[[cuts]]
edges = [2, 5, 9]

[[cuts.thresholds]]
edges = [3, 5, 11, 14]

[[cuts.thresholds.counterterms]]
name = \"gl368_maximal\"
subspace = [3, 11]
parent_lmb = [3, 5, 9, 11]

[[cuts.thresholds]]
