\"nFb()\" = \"((abs(fb())-fb())/2)^4\"
\"wD()\" = \"aS()+aT()+aN()\"
\"wDV()\" = \"wu()^2*wD()+wExtra()\"
\"wExtra()\" = \"(hs()*ht()*fa()*fb()*wp()*wq()*wr())^2\"
\"wQ()\" = \"P(0,cind(0))+P(1,cind(0))\"
