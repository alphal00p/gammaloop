\"fb()\" = \"(E(star,6)+E(star,12)+E(star,14)-wQ())/wQ()\"
\"hs()\" = \"(dE(UFO::MT,UFO::MT,E(star,11),E(star,6),Q3(star,11,cind(1)),Q3(star,11,cind(2)),Q3(star,11,cind(3)),Q3(star,6,cind(1)),Q3(star,6,cind(2)),Q3(star,6,cind(3)))+E(star,13))/wQ()\"
