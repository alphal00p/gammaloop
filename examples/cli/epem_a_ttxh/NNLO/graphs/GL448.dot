\"wq()\" = \"(E(star,7)+E(star,13)+E(star,14)-wQ())/wQ()\"
\"wr()\" = \"(E(star,8)+E(star,11)+E(star,12)-wQ())/wQ()\"
\"wu()\" = \"(E(star,4)+E(star,8)+E(star,11)+E(star,14)-wQ())/wQ()\"

