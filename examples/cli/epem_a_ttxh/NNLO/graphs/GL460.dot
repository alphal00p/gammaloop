digraph GL460{
    // Retain native two-loop charts at competing hard thresholds, and share
    // one-loop charts across soft-related cuts through complementary weights.
    threshold_counterterms = "
schema_version = 1

[function_map]
\"NL()\" = \"if(denL(),dL()^2/denL(),1)\"
\"NR()\" = \"if(denR(),dR()^2/denR(),1)\"
\"SL()\" = \"if(denL(),pL()^2/denL(),0)\"
\"SR()\" = \"if(denR(),pR()^2/denR(),0)\"
\"dL()\" = \"dE(UFO::MT,UFO::MT,E(star,6),E(star,8),Q3(star,6,cind(1)),Q3(star,6,cind(2)),Q3(star,6,cind(3)),Q3(star,8,cind(1)),Q3(star,8,cind(2)),Q3(star,8,cind(3)))+E(star,13)\"
\"dR()\" = \"dE(UFO::MT,UFO::MT,E(star,4),E(star,8),Q3(star,4,cind(1)),Q3(star,4,cind(2)),Q3(star,4,cind(3)),Q3(star,8,cind(1)),Q3(star,8,cind(2)),Q3(star,8,cind(3)))+E(star,13)\"
\"denL()\" = \"dL()^2+pL()^2\"
\"denR()\" = \"dR()^2+pR()^2\"
\"p26()\" = \"E(star,6)+E(star,8)+E(star,13)-wQ()\"
\"p27()\" = \"E(star,6)+E(star,8)+E(star,11)+E(star,12)-wQ()\"
\"p28()\" = \"E(star,7)+E(star,8)-wQ()\"
\"p38()\" = \"E(star,4)+E(star,7)+E(star,11)+E(star,12)-wQ()\"
\"p46()\" = \"E(star,4)+E(star,7)+E(star,13)-wQ()\"
\"pL()\" = \"p28()*p26()*p27()/wQ()^2\"
\"pR()\" = \"p28()*p46()*p38()/wQ()^2\"
\"wQ()\" = \"P(0,cind(0))+P(1,cind(0))\"

[[cuts]]
edges = [2, 3, 6]

[[cuts.thresholds]]
edges = [6, 8, 11, 12]

[[cuts.thresholds.counterterms]]
name = \"default\"
subspace = [7, 11]
