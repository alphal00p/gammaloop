digraph GL638{
    num = "1𝑖";
    overall_factor = "NumeratorDependentGrouping(638,1,(AutG(1))^(-1)*AntiFermionSpinSumSign(-1)*ExternalFermionOrderingSign(-1)*InternalFermionLoopSign(-1)*NumeratorIndependentSymmetryGrouping(2))+NumeratorDependentGrouping(639,1,(AutG(1))^(-1)*AntiFermionSpinSumSign(-1)*ExternalFermionOrderingSign(-1)*InternalFermionLoopSign(-1)*NumeratorIndependentSymmetryGrouping(2))";
    overall_factor_evaluated = "-4";
    projector = "u(1,spenso::bis(4,hedge(1)))*ubar(1,spenso::bis(4,hedge(29)))*v(0,spenso::bis(4,hedge(28)))*vbar(0,spenso::bis(4,hedge(0)))";
    // Higgs-aware threshold splitting on cut (2,6,10); all other cuts retain their
    // natural one-loop subspaces. Every explicit parent [3,6,7,10] preserves this cut.
    // A=(7,8), U=(8,12,14): [7] weight 1-W_H, [3,7] weight W_H.
    // F=(8,10,13,14): [7] weight 1-W_F, [3,7] weight W_F.
    // V=(3,7,14), P=(3,12), Z=(3,10,13) retain unit-weight [3,7] variants.
    // At each variant's star, Q=P0^0+P1^0, H=eta(2,4,12),
    // G0=eta(2,6,12,13), G4=eta(2,4,10,13):
    // W_H=H^2/(H^2+(P*Z/Q)^2), W_F=G0^2*G4^2/(G0^2*G4^2+P^2*Z^2).
    // The explicit energy expressions below avoid requiring foreign-cut surfaces in
    // the local catalogue; rationalized energy differences preserve soft cancellations.
    // W_H and its complement have explicit complementary values at their common zero.
    // This replaces the old (2,4,12) embedded projection that moved the opposite side.
    // The candidate passes the sampled soft/ordinary-threshold checks and generates
    // all 936 orientations with full UV. Exact coincident A/P radial roots still need
    // a stable combined-residue limit; generation and pilot runs do not certify it.
    // See IR_SAFE_THRESHOL_UPDATE.md for validation, weights and remaining limitations.
    threshold_counterterms = "
