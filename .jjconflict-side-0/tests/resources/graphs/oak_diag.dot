digraph oak_diag{
  num = "1";
  overall_factor = "1";
  overall_factor_evaluated = "1";
  projector = "1";
  v0[dod="-100" num="1"];
  v1[dod="-100" num="1"];
  v2[dod="-100" num="1"];
  v3[dod="-100" num="1"];
  v4[dod="-100" num="1"];
  v5[dod="-100" num="1"];
  v6[dod="-100" num="1"];

  ext0	 [style=invis];
  v4:0	-> ext0	 [id=0 dir=none source="{ufo_order:0}" dod="-100" lmb_rep="P(0,a___)" name="e0" num="1" particle="scalar_2"]; // p4
  ext1	 [style=invis];
  ext1	-> v0:1	 [id=1 dir=none sink="{ufo_order:0}" dod="-100" lmb_rep="P(1,a___)" name="e1" num="1" particle="scalar_1"]; // p1
  ext2	 [style=invis];
  ext2	-> v4:2	 [id=2 dir=none sink="{ufo_order:1}" dod="-100" lmb_rep="P(2,a___)" name="e2" num="1" particle="scalar_2"]; // p2
  ext3	 [style=invis];
  v3:3	-> ext3	 [id=3 dir=none source="{ufo_order:0}" dod="-100" lmb_rep="-1*P(0,a___)+P(1,a___)+P(2,a___)" name="e3" num="1" particle="scalar_1"]; // p3
  v0:4	-> v1:5	 [id=4 dir=none source="{ufo_order:1}" sink="{ufo_order:0}"  dod="-100" lmb_rep="K(0,a___)+P(1,a___)" name="e4" num="1" particle="scalar_1"];
  v1:6	-> v2:7	 [id=5 dir=none source="{ufo_order:1}" sink="{ufo_order:0}"  dod="-100" lmb_rep="K(0,a___)+K(1,a___)+P(1,a___)" name="e5" num="1" particle="scalar_1"];
  v2:8	-> v3:9	 [id=6 dir=none source="{ufo_order:1}" sink="{ufo_order:1}"  dod="-100" lmb_rep="K(0,a___)+K(1,a___)+K(2,a___)+P(1,a___)" name="e6" num="1" particle="scalar_1"];
  v5:12	-> v0:13	 [id=7 dir=none source="{ufo_order:0}" sink="{ufo_order:2}"  dod="-100" lmb_id="0" lmb_rep="K(0,a___)" name="e7" num="1" particle="scalar_0"];
  v5:16	-> v4:17	 [id=8 dir=none source="{ufo_order:2}" sink="{ufo_order:2}"  dod="-100" lmb_rep="-1*K(0,a___)+-1*K(1,a___)" name="e8" num="1" particle="scalar_0"];
  v5:14	-> v1:15	 [id=9 dir=none source="{ufo_order:1}" sink="{ufo_order:2}"  dod="-100" lmb_id="1" lmb_rep="K(1,a___)" name="e9" num="1" particle="scalar_0"];
  v6:18	-> v2:19	 [id=10 dir=none source="{ufo_order:1}" sink="{ufo_order:2}"  dod="-100" lmb_id="2" lmb_rep="K(2,a___)" name="e10" num="1" particle="scalar_0"];
  v3:10	-> v6:11	 [id=11 dir=none source="{ufo_order:2}" sink="{ufo_order:0}"  dod="-100" lmb_rep="-1*P(2,a___)+K(0,a___)+K(1,a___)+K(2,a___)+P(0,a___)" name="e11" num="1" particle="scalar_0"];
  v6:20	-> v4:21	 [id=12 dir=none source="{ufo_order:2}" sink="{ufo_order:3}"  dod="-100" lmb_rep="-1*P(2,a___)+K(0,a___)+K(1,a___)+P(0,a___)" name="e12" num="1" particle="scalar_0"];
}
