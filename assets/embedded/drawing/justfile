# Number of layout steps per epoch and epochs.
steps := "100"
epochs := "30"
seed := "42"

# Number of columns per amplitude or xs
columns := "3"
rows := "5"

drawing_styles := "--style drawings/templates/edge-style.typ --style drawings/templates/layout.typ --style drawings/templates/layout-core.typ --style drawings/templates/physics-edge-style.typ --style drawings/templates/impl/physics-edge-style.typ --style drawings/templates/crates/linnest/typst/src/lib.typ --style drawings/templates/crates/linnest/typst/src/graph.typ --style drawings/templates/crates/linnest/typst/src/subgraph.typ --style drawings/templates/crates/linnest/typst/src/draw.typ --style drawings/templates/crates/linnest/typst/src/curve.typ --style drawings/templates/crates/linnest/typst/linnest.wasm --style drawings/templates/crates/kurvst/typst/src/lib.typ --style drawings/templates/crates/kurvst/typst/kurvst.wasm"
drawing_templates := "--figure-template drawings/templates/figure.typ --grid-template drawings/templates/grid.typ"

# Output names used by the drawing mode demo recipes
draw_default_output := "drawings-default.pdf"
draw_debug_output := "drawings-debug.pdf"
draw_momentum_output := "drawings-momentum.pdf"
draw_momentum_labels_output := "drawings-momentum-labels.pdf"
draw_momentum_lines_output := "drawings-momentum-lines.pdf"

# Drawing mode options. Override from the CLI with e.g.
#   just momentum_mark=none momentum_paint=red draw-momentum
momentum_arrows := "true"
momentum_mark := "auto"
momentum_paint := "#3d2645"
momentum_thickness := "1.0pt"
show_edge_index := "true"
show_node_index := "true"
show_half_edge_index := "false"
# Keep the model's mapped particle labels by default; set this to false to hide
# the particle portion of combined particle and momentum labels.
show_particle := "true"

# Defaults for the highlighted momentum-line demo. Override
# `momentum_line_mark=none` to draw the offset lines without arrowheads.
momentum_line_mark := "auto"
momentum_line_paint := "red"
momentum_line_thickness := "1.0pt"

# Internal drawing helper. EXTRA_INPUTS are passed straight to linnet, so
# recipes below can demonstrate drawing modes without hiding the underlying CLI.
_draw-output OUTPUT *EXTRA_INPUTS:
	linnet \
	  --build-dir drawings draw . \
	  {{drawing_templates}} \
	  {{drawing_styles}} \
	  --input steps={{steps}} \
	  --input epochs={{epochs}} \
	  --input seed={{seed}} \
	  --input columns={{columns}} \
	  --input rows={{rows}} \
	  -o {{OUTPUT}} {{EXTRA_INPUTS}}

# Generate drawings from dot files taking into account steps and columns.
# Amplitudes order external legs by edge id. Cross sections pair both sides by
# their `is_cut` tag. Override detection by passing `--input` with
# `amplitude-mode=true|false` or `cross-section-mode=true|false`.
draw *EXTRA_INPUTS: (_draw-output "drawings.pdf" EXTRA_INPUTS)

# Generate the plain particle-style drawings.
draw-default *EXTRA_INPUTS: (_draw-output draw_default_output EXTRA_INPUTS)

# Show Linnest node and half-edge IDs without enabling momentum arrows.
draw-debug *EXTRA_INPUTS: (_draw-output draw_debug_output "--input debug=true" EXTRA_INPUTS)

# Generate drawings with source-to-sink momentum arrows and q_(eid)/n_i identifiers.
draw-momentum *EXTRA_INPUTS:
	linnet \
	  --build-dir drawings draw . \
	  {{drawing_templates}} \
	  --input 'momentum-arrows={{momentum_arrows}}' \
	  --input 'momentum-arrow-mark={{momentum_mark}}' \
	  --input 'momentum-arrow-paint={{momentum_paint}}' \
	  --input 'momentum-arrow-thickness={{momentum_thickness}}' \
	  --input 'show-node-index={{show_node_index}}' \
	  {{drawing_styles}} \
	  --input steps={{steps}} \
	  --input epochs={{epochs}} \
	  --input seed={{seed}} \
	  --input columns={{columns}} \
	  --input rows={{rows}} \
	  -o {{draw_momentum_output}} {{EXTRA_INPUTS}}

# Generate drawings with momentum arrows plus particle and q_(eid)/n_i labels.
draw-momentum-labels *EXTRA_INPUTS:
	linnet \
	  --build-dir drawings draw . \
	  {{drawing_templates}} \
	  --input 'momentum-arrows={{momentum_arrows}}' \
	  --input 'momentum-arrow-mark={{momentum_mark}}' \
	  --input 'momentum-arrow-paint={{momentum_paint}}' \
	  --input 'momentum-arrow-thickness={{momentum_thickness}}' \
	  --input 'show-edge-index={{show_edge_index}}' \
	  --input 'show-node-index={{show_node_index}}' \
	  --input 'show-half-edge-index={{show_half_edge_index}}' \
	  --input 'show-particle={{show_particle}}' \
	  {{drawing_styles}} \
	  --input steps={{steps}} \
	  --input epochs={{epochs}} \
	  --input seed={{seed}} \
	  --input columns={{columns}} \
	  --input rows={{rows}} \
	  -o {{draw_momentum_labels_output}} {{EXTRA_INPUTS}}

# Generate drawings with highlighted momentum lines, arrowheads, and q_(eid)/n_i identifiers.
draw-momentum-lines *EXTRA_INPUTS:
	linnet \
	  --build-dir drawings draw . \
	  {{drawing_templates}} \
	  --input 'momentum-arrows={{momentum_arrows}}' \
	  --input 'momentum-arrow-mark={{momentum_line_mark}}' \
	  --input 'momentum-arrow-paint={{momentum_line_paint}}' \
	  --input 'momentum-arrow-thickness={{momentum_line_thickness}}' \
	  --input 'show-node-index={{show_node_index}}' \
	  {{drawing_styles}} \
	  --input steps={{steps}} \
	  --input epochs={{epochs}} \
	  --input seed={{seed}} \
	  --input columns={{columns}} \
	  --input rows={{rows}} \
	  -o {{draw_momentum_lines_output}} {{EXTRA_INPUTS}}

# Build one PDF per bundled drawing mode.
draw-modes: draw-default draw-momentum draw-momentum-labels draw-momentum-lines

# Generate a single figure from dot files
draw-single FIGURE *EXTRA_INPUTS:
	linnet \
	  --build-dir drawings redraw-figure {{FIGURE}} \
	  --input seed={{seed}} \
	  --input steps={{steps}} --input epochs={{epochs}} {{EXTRA_INPUTS}}
	linnet \
	  --build-dir drawings redraw-grid \
	  --input columns={{columns}} \
	  --input rows={{rows}} \
	  -o drawings.pdf {{EXTRA_INPUTS}}
